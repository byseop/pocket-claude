# Copy to /home/ubuntu/.config/pocket-claude/secrets.env and chmod 600.
# Loaded by claude-rc@.service (EnvironmentFile), so anything here is part of
# the Claude session's environment and visible to the session via `env`.
# The boot-manager bot token lives in telegram.env for that reason.
# systemd syntax: KEY=value, one per line, comments only on their own line.
# Never put CLAUDE_CODE_OAUTH_TOKEN here: it blocks Remote Control.

# Tool logins for the session. Alternatives: `gh auth login`, `npx vercel login`.
GH_TOKEN=github_pat_xxx
VERCEL_TOKEN=xxx
SUPABASE_ACCESS_TOKEN=sbp_xxx
