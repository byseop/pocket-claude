# Copy to /home/ubuntu/.config/pocket-claude/telegram.env and chmod 600.
# Read only by idle-watch.sh for the "shutting down" notice. Idle auto-stop
# is currently unused (stopping is manual, see docs/OPERATIONS.md), so this
# file is not required, but is kept for when it is revived. No Claude session
# ever loads it: session environment comes only from
# projects/<project>.env, and this token has no business being there.
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000
