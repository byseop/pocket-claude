# Copy to /home/ubuntu/.config/gamer4/telegram.env and chmod 600.
# Read only by idle-watch.sh for the "shutting down" notice. Kept out of
# secrets.env on purpose: secrets.env is loaded into every Claude session's
# environment by claude-rc@.service, and a session transcript is stored on
# Anthropic's servers.
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000
