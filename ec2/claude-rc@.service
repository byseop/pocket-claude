[Unit]
Description=Claude Code Remote Control session (%i)
After=network-online.target
Wants=network-online.target
# A crash loop parks the unit in "failed" (visible in /status) instead of restarting forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Environment=HOME=/home/ubuntu
# Optional: GH_TOKEN, VERCEL_TOKEN, SUPABASE_ACCESS_TOKEN for the session's
# tools. Everything here becomes part of the session's environment, so keep
# out anything the session must not read. The leading "-" keeps the unit
# bootable when the file is missing. Never put CLAUDE_CODE_OAUTH_TOKEN here.
EnvironmentFile=-/home/ubuntu/.config/pocket-claude/projects/%i.env
ExecStart=/home/ubuntu/bin/claude-rc-wrap.sh %i
# One tmux server per unit (socket rc-%i): keeps each session in its own cgroup.
ExecStop=/usr/bin/tmux -L rc-%i kill-session -t rc-%i
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
Slice=claude-rc.slice

[Install]
WantedBy=multi-user.target
