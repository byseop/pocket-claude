# Per-project environment file. Copy to
# /home/ubuntu/.config/pocket-claude/projects/<project>.env and chmod 600.
# There is no shared secret file: every value lives with the project that
# needs it. Loaded by claude-rc@<project>.service (EnvironmentFile), so
# anything here is part of that project's Claude session environment and
# visible to the session via `env`. Nothing here reaches another project.
# systemd syntax: KEY=value, one per line, comments only on their own line.
# Never put CLAUDE_CODE_OAUTH_TOKEN here: it blocks Remote Control.

# Tool logins for this project's session. Usually unnecessary: `gh auth login`
# and `npx vercel login` store credentials of their own that every session
# picks up without an environment variable.
GH_TOKEN=github_pat_xxx
VERCEL_TOKEN=xxx
SUPABASE_ACCESS_TOKEN=sbp_xxx
AWS_PROFILE=default

# Spawn mode and concurrent-session capacity, for this project only.
POCKET_SPAWN=worktree
POCKET_SESSIONS=2
