{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(npx vercel ls:*)",
      "Bash(npx vercel logs:*)",
      "Bash(npx vercel metrics:*)",
      "Bash(npx vercel inspect:*)",
      "Bash(sam logs:*)",
      "Bash(aws logs:*)",
      "Bash(aws cloudformation describe-stacks:*)",
      "Bash(aws cloudformation describe-stack-events:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn verify:*)",
      "Bash(yarn test:*)"
    ],
    "ask": [
      "Bash(sam deploy:*)",
      "Bash(cdk deploy:*)",
      "Bash(terraform apply:*)",
      "Bash(npx vercel promote:*)",
      "Bash(npx vercel redeploy:*)",
      "Bash(npx vercel env:*)",
      "Bash(npx vercel firewall:*)",
      "Bash(npx vercel api:*)",
      "Bash(gh pr merge:*)",
      "Bash(aws lambda update-function-code:*)",
      "Bash(aws lambda update-function-configuration:*)",
      "Bash(aws ec2 stop-instances:*)",
      "Bash(docker push:*)",
      "Bash(npm publish:*)"
    ],
    "deny": [
      "Bash(aws iam:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(~/.config/pocket-claude/secrets.env)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "/home/ubuntu/bin/worktree-env-hook.sh" } ] }
    ]
  },
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
