# Copy to .env and fill in your own values. .env is gitignored.
#
# These are set as Lambda environment variables on the ec2-boot-manager function.
# Nothing here belongs in source control.

# Telegram bot token for the boot-manager bot (from @BotFather)
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only this Telegram chat ID may issue commands. Find yours via @userinfobot.
ALLOWED_CHAT_ID=000000000

# The EC2 instance running Claude Code
INSTANCE_ID=i-0000000000000000

# Region of that instance. On Lambda this is injected automatically;
# set it only for local runs.
AWS_REGION=ap-northeast-2
